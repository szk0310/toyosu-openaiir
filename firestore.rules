rules_version = '2';

// ============================================================
//  Open Air / toyosuopenair  Firestore セキュリティルール
//
//  方針:
//   - パスワードは Firestore に保存しない（Firebase Auth 管理）。
//   - read / write とも「ログイン済み(非匿名)ユーザー」に限定する。
//     ※ 2026-07-30 変更: 以前は read を公開(if true)にしていたが、認証なしで
//        facilityData の login_id・担当者メールアドレスまで外部から取得できる
//        状態だったため、全コレクションで認証必須に変更した。
//        このデータを参照する公開サイトは存在しないことを確認済み。
//   - facilityData の更新は本人(uid一致) または 管理者のみ。作成/削除は管理者のみ。
//   - ideaData / caseData は管理者のみ編集。
//   - 管理者判定は admins/{uid} ドキュメントの有無で行う（作成はコンソールで手動）。
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // 非匿名でログインしているか
    function signedIn() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // 管理者か（admins/{uid} が存在するか）
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // 施設データ（login_id・担当者メールを含むため read も認証必須）
    match /facilityData/{fid} {
      allow read:   if signedIn();
      allow create: if isAdmin();
      allow delete: if isAdmin();
      // 本人(uid一致) または 管理者のみ更新可
      allow update: if isAdmin()
                    || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // スペース（施設が編集）: read/write ともログイン済み
    match /spaceData/{doc} {
      allow read:  if signedIn();
      allow write: if signedIn();
    }

    // カレンダー/予約: read/write ともログイン済み
    match /calendarData/{doc} {
      allow read:  if signedIn();
      allow write: if signedIn();
    }

    // アイデア（管理者コンテンツ）: read はログイン済み / write は管理者のみ
    match /ideaData/{doc} {
      allow read:  if signedIn();
      allow write: if isAdmin();
    }

    // 事例（管理者コンテンツ）: read はログイン済み / write は管理者のみ
    match /caseData/{doc} {
      allow read:  if signedIn();
      allow write: if isAdmin();
    }

    // 管理者判定用: 自分のドキュメントのみ read 可。write はコンソールからのみ。
    match /admins/{uid} {
      allow read:  if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // 上記以外は全面禁止
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

// ------------------------------------------------------------
//  （任意のさらなる強化）spaceData / calendarData を「その施設の所有者のみ」に
//  限定したい場合は、各ドキュメントに f_id を持たせた上で下記のように書く:
//
//    match /spaceData/{doc} {
//      allow read: if true;
//      allow write: if isAdmin()
//        || (signedIn()
//            && get(/databases/$(database)/documents/facilityData/$(request.resource.data.f_id)).data.uid == request.auth.uid);
//    }
//
//  現状は「ログイン施設なら書込可」の緩めの設定（利用者が信頼できる少数のため）。
// ------------------------------------------------------------
