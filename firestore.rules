rules_version = '2';

// ============================================================
//  Open Air / toyosuopenair  Firestore セキュリティルール
//
//  方針:
//   - パスワードは Firestore に保存しない（Firebase Auth 管理）。
//   - 公開サイト（/open_air/）が表示に使うデータは未認証でも read できる。
//     ただし facilityData だけは login_id・担当者メールを含むため非公開。
//   - 施設は「自分のデータだけ」read / write できる（所有者は uid で判定）。
//   - 管理者(admins/{uid} を持つユーザー)は全データを read / write できる。
//   - 匿名ユーザーは一切アクセスできない。
//
//  変更履歴:
//   - 2026-07-24 初版。read は公開(if true)だった。
//   - 2026-07-30 第1段階: 認証なしで facilityData の login_id・担当者メール
//     アドレスが外部から取得できたため、全コレクションで認証必須に変更。
//   - 2026-07-30 第2段階: ログイン済みの施設同士が相互に閲覧できる状態だった
//     ため、所有者(uid一致)と管理者のみに限定。
//   - 2026-07-30 第3段階: 上記で公開サイト(/open_air/)の表示が壊れたため、
//     公開サイトが実際に読む4コレクションのみ未認証 read を戻した。
//     facilityData は引き続き非公開（ここに login_id と担当者メールがある）。
//     公開サイトが読むもの: caseData / ideaData / spaceData(s_release=='on') /
//     calendarData。facilityData は読んでいないことを実機で確認済み。
//
//  ★重要（改修する人へ）:
//   list（クエリ）は「ルールがフィルタしてくれる」わけではありません。
//   resource.data.uid を参照するルールの下では、クエリ側も
//   .where("uid","==",<自分のuid>) で絞らないと Firestore に拒否されます。
//   施設側の全クエリは uid で絞るよう実装済みです。
//   また spaceData / calendarData の新規作成時は uid の書き込みが必須です。
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // 非匿名でログインしているか
    function signedIn() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // 管理者か（admins/{uid} が存在するか）
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // 既存ドキュメントの所有者か
    function ownsExisting() {
      return signedIn() && resource.data.uid == request.auth.uid;
    }

    // 書き込もうとしている内容の所有者が自分か（uid の付け替えを防ぐ）
    function ownsIncoming() {
      return signedIn() && request.resource.data.uid == request.auth.uid;
    }

    // 存在しないドキュメントの取得。resource が null のとき
    // resource.data.uid を評価するとエラーで拒否されるため、明示的に許可する
    // （存在しないものを「無い」と返すだけなので情報は漏れない）。
    function missingDoc() {
      return signedIn() && resource == null;
    }

    // 更新前後で値が変わっていないこと（フィールドの改変防止）
    function unchanged(field) {
      return request.resource.data.get(field, null) == resource.data.get(field, null);
    }

    // ID が数字のみか（Date.now() 由来のため。正規表現メタ文字の混入を防ぐ）
    function numericId(v) {
      return v is string && v.matches('^[0-9]+$');
    }

    // 作成しようとしている spaceData の親施設を自分が所有しているか
    function ownsParentFacility() {
      return signedIn()
        && get(/databases/$(database)/documents/facilityData/$(request.resource.data.f_id)).data.uid == request.auth.uid;
    }

    // 作成しようとしている calendarData の親スペースを自分が所有しているか
    function ownsParentSpace() {
      return signedIn()
        && get(/databases/$(database)/documents/spaceData/$(request.resource.data.s_id)).data.uid == request.auth.uid;
    }

    // 施設データ（login_id・担当者メールを含む。所有者と管理者のみ）
    match /facilityData/{fid} {
      allow get:    if isAdmin() || missingDoc() || ownsExisting();
      allow list:   if isAdmin() || ownsExisting();
      allow create: if isAdmin()
                    && fid == request.resource.data.f_id && numericId(fid);
      allow delete: if isAdmin();
      // 施設本人の更新では uid / f_id / login_id を変更させない。
      // これらが変わると spaceData との紐付けや管理者画面の表示が壊れる。
      // （f_release は施設が自分で公開/非公開を切り替える仕様なので制限しない）
      allow update: if isAdmin()
                    || (ownsExisting() && ownsIncoming() && unchanged('f_id'));
    }

    // 施設の秘匿情報（ログインIDと担当者メール）。
    // ★ facilityData から分離したもの。公開サイトの施設詳細ページは
    //   facilityData を doc(f_id).get() で読むため、同じ文書に秘匿情報を
    //   置いておくと doc.data() 経由でブラウザに渡ってしまう。
    //   ここに隔離し、所有者と管理者だけが読めるようにする。
    match /facilityPrivate/{fid} {
      allow get:    if isAdmin() || missingDoc() || ownsExisting();
      allow list:   if isAdmin();
      allow create: if isAdmin()
                    && fid == request.resource.data.f_id && numericId(fid);
      // 施設本人は連絡先メールのみ変更できる。login_id と uid は固定。
      allow update: if isAdmin()
                    || (ownsExisting() && ownsIncoming()
                        && unchanged('f_id') && unchanged('login_id'));
      allow delete: if isAdmin();
    }

    // スペース（施設が編集）
    match /spaceData/{doc} {
      // 公開サイトは .where("s_release","==","on") で絞って取得するため、
      // 公開中のスペースに限り未認証でも読める。非公開のものは漏れない。
      allow get:    if isAdmin() || missingDoc() || ownsExisting()
                    || resource.data.s_release == 'on';
      allow list:   if isAdmin() || ownsExisting()
                    || resource.data.s_release == 'on';
      // 自分の uid を書くだけでなく、親施設も自分のものであることを要求する。
      // ★ ドキュメントIDと s_id を一致させ、さらに数字のみに限定する。
      //   これを怠ると s_id に正規表現のメタ文字（例: ".*"）を仕込んだ
      //   スペースを作れてしまい、calendarData 側の doc.matches() による
      //   検証が任意のドキュメントIDに一致して機能しなくなる。
      allow create: if isAdmin()
                    || (ownsIncoming() && ownsParentFacility()
                        && doc == request.resource.data.s_id
                        && numericId(doc)
                        && numericId(request.resource.data.f_id));
      allow update: if isAdmin()
                    || (ownsExisting() && ownsIncoming()
                        && unchanged('f_id') && unchanged('s_id'));
      allow delete: if isAdmin() || ownsExisting();
    }

    // カレンダー/予約（施設が編集）
    //  ドキュメントIDは {s_id}_{年}_{月}。他施設のスペースIDで先回り作成されると
    //  その施設が当該月を読むことも保存することもできなくなるため、
    //  親スペースの所有とドキュメントIDの整合を両方要求する。
    match /calendarData/{doc} {
      // 公開サイトの検索画面が全件取得する。空き状況は公開情報であり
      // 認証情報を含まないため read は公開でよい。書き込みは所有者のみ。
      allow read:   if true;
      // s_id を数字のみに限定したうえで {s_id}_{年}_{月} の形を厳密に要求する
      allow create: if isAdmin()
                    || (ownsIncoming() && ownsParentSpace()
                        && numericId(request.resource.data.s_id)
                        && doc.matches('^' + request.resource.data.s_id + '_[0-9]{4}_[0-9]{1,2}$'));
      allow update: if isAdmin()
                    || (ownsExisting() && ownsIncoming() && unchanged('s_id'));
      allow delete: if isAdmin() || ownsExisting();
    }

    // アイデア（公開サイトのトップに掲載される。編集は管理者のみ）
    match /ideaData/{doc} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // 事例（公開サイトのトップに掲載される。編集は管理者のみ）
    match /caseData/{doc} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // 管理者判定用: 自分のドキュメントのみ read 可。write はコンソールからのみ。
    match /admins/{uid} {
      allow read:  if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // 上記以外は全面禁止
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
