rules_version = '2';

// ============================================================
//  Open Air / toyosuopenair  Firestore セキュリティルール
//
//  方針:
//   - パスワードは Firestore に保存しない（Firebase Auth 管理）。
//   - 施設は「自分のデータだけ」read / write できる（所有者は uid で判定）。
//   - 管理者(admins/{uid} を持つユーザー)は全データを read / write できる。
//   - 匿名ユーザーは一切アクセスできない。
//
//  変更履歴:
//   - 2026-07-24 初版。read は公開(if true)だった。
//   - 2026-07-30 第1段階: 認証なしで facilityData の login_id・担当者メール
//     アドレスが外部から取得できたため、全コレクションで認証必須に変更。
//   - 2026-07-30 第2段階: ログイン済みの施設同士が相互に閲覧できる状態だった
//     ため、所有者(uid一致)と管理者のみに限定。
//
//  ★重要（改修する人へ）:
//   list（クエリ）は「ルールがフィルタしてくれる」わけではありません。
//   resource.data.uid を参照するルールの下では、クエリ側も
//   .where("uid","==",<自分のuid>) で絞らないと Firestore に拒否されます。
//   施設側の全クエリは uid で絞るよう実装済みです。
//   また spaceData / calendarData の新規作成時は uid の書き込みが必須です。
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // 非匿名でログインしているか
    function signedIn() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // 管理者か（admins/{uid} が存在するか）
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // 既存ドキュメントの所有者か
    function ownsExisting() {
      return signedIn() && resource.data.uid == request.auth.uid;
    }

    // 書き込もうとしている内容の所有者が自分か（uid の付け替えを防ぐ）
    function ownsIncoming() {
      return signedIn() && request.resource.data.uid == request.auth.uid;
    }

    // 存在しないドキュメントの取得。resource が null のとき
    // resource.data.uid を評価するとエラーで拒否されるため、明示的に許可する
    // （存在しないものを「無い」と返すだけなので情報は漏れない）。
    function missingDoc() {
      return signedIn() && resource == null;
    }

    // 施設データ（login_id・担当者メールを含む。所有者と管理者のみ）
    match /facilityData/{fid} {
      allow get:    if isAdmin() || missingDoc() || ownsExisting();
      allow list:   if isAdmin() || ownsExisting();
      allow create: if isAdmin();
      allow delete: if isAdmin();
      allow update: if isAdmin() || (ownsExisting() && ownsIncoming());
    }

    // スペース（施設が編集）
    match /spaceData/{doc} {
      allow get:    if isAdmin() || missingDoc() || ownsExisting();
      allow list:   if isAdmin() || ownsExisting();
      allow create: if isAdmin() || ownsIncoming();
      allow update: if isAdmin() || (ownsExisting() && ownsIncoming());
      allow delete: if isAdmin() || ownsExisting();
    }

    // カレンダー/予約（施設が編集）
    match /calendarData/{doc} {
      allow get:    if isAdmin() || missingDoc() || ownsExisting();
      allow list:   if isAdmin() || ownsExisting();
      allow create: if isAdmin() || ownsIncoming();
      allow update: if isAdmin() || (ownsExisting() && ownsIncoming());
      allow delete: if isAdmin() || ownsExisting();
    }

    // アイデア（管理者専用コンテンツ。施設側の画面からは参照しない）
    match /ideaData/{doc} {
      allow read:  if isAdmin();
      allow write: if isAdmin();
    }

    // 事例（管理者専用コンテンツ。施設側の画面からは参照しない）
    match /caseData/{doc} {
      allow read:  if isAdmin();
      allow write: if isAdmin();
    }

    // 管理者判定用: 自分のドキュメントのみ read 可。write はコンソールからのみ。
    match /admins/{uid} {
      allow read:  if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // 上記以外は全面禁止
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
